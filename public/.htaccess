# Tu-vi · Server-Einstellungen für Hetzner (Apache)
#
# Ohne diese Zeilen liefert der Apache das Manifest ohne Zeichensatz-Angabe
# aus. Der Browser raet dann Latin-1, und aus "Tu-vi – Lehrertool" wird
# "Tu-vi â€“ Lehrertool". Unter dem App-Symbol auf dem Home-Bildschirm
# stuende dann Buchstabensalat.
AddType application/manifest+json .webmanifest
AddCharset UTF-8 .webmanifest
AddCharset UTF-8 .json

# Die App ist eine einzige HTML-Datei mit eingebettetem JavaScript. Der
# Zeichensatz steht zwar im <meta>-Tag, eine Kopfzeile vom Server ist aber
# verbindlicher und greift schon vor dem Parsen.
AddCharset UTF-8 .html

# Der Service Worker darf nicht aus dem Browser-Cache kommen, sonst
# bemerkt die App eine neu hochgeladene Version tagelang nicht.
<FilesMatch "(sw\.js|registerSW\.js|manifest\.webmanifest)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Ueber die Anmeldemaske gehen E-Mail und Passwort. Wird tu-vi.de versehentlich
# ueber http:// aufgerufen - etwa aus einem alten Lesezeichen oder im
# Schul-WLAN -, koennte die ausgelieferte HTML-Datei unterwegs veraendert
# werden, bevor der Browser die Content-Security-Policy ueberhaupt sieht.
# Deshalb hart auf https:// umleiten.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Ein Jahr lang gar nicht erst unverschluesselt anfragen.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Der Browser soll den vom Server genannten Dateityp glauben und nicht raten.
  Header always set X-Content-Type-Options "nosniff"
  # Beim Verlassen der Seite nicht verraten, welche Unterseite offen war.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Tu-vi gehoert in kein fremdes Rahmenfenster - sonst liesse sich die
  # Anmelde- oder Sperrmaske hinter einer harmlosen Seite verstecken.
  # frame-ancestors wirkt nur als Kopfzeile, im <meta>-Tag wird es ignoriert.
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  # Kamera und Mikrofon braucht nur Tu-vi selbst (Dokumente fotografieren,
  # Spracheingabe), eingebettete Inhalte nicht. Ortung gar nicht.
  Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=(self)"
</IfModule>
